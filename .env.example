# Copy this file to .env and fill in real values. Never commit .env.

# --- Firebase client config (safe to expose in the browser) ---
# Firebase Console -> Project settings -> General -> Your apps -> Web app
# (create one if you haven't). These identify the project; they are not
# secrets — access control is enforced server-side, not by hiding these.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (server-side only — never exposed to the browser) ---
# Firebase Console -> Project settings -> Service accounts -> Generate new
# private key. Downloads a JSON file; copy the three fields below from it.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private_key value from that JSON file. Keep the \n sequences
# literal (don't turn them into real newlines) — the app converts them
# back at startup. Wrap the whole value in quotes.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Gemini ---
# Server-side only. From Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
